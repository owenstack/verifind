{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "deploy": {
      "cache": false,
      "interactive": true
    },
    "destroy": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": [
    "AXIOM_API_KEY",
    "AXIOM_DATASET",
    "AXIOM_EDGE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "NODE_ENV",
    "VITE_SERVER_URL",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
