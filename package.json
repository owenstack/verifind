{
  "name": "verifind",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "@orpc/server": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.7",
      "next-themes": "^0.4.6",
      "@orpc/client": "^1.15.6",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @verifind/db --",
    "deploy": "turbo run deploy -F @verifind/infra --",
    "destroy": "turbo run destroy -F @verifind/infra --",
    "dev": "turbo run dev",
    "dev:email": "turbo run dev -F @verifind/email --",
    "dev:infra": "turbo run dev -F @verifind/infra --",
    "dev:web": "turbo run dev:bare -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^26.4.1",
    "@verifind/config": "workspace:*",
    "lefthook": "latest",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
